rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTask(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.importance is int && data.importance >= 1 && data.importance <= 4 &&
             data.estimatedEffortMinutes is int && data.estimatedEffortMinutes >= 0 && data.estimatedEffortMinutes <= 10080 &&
             data.dueDate is int && data.dueDate >= 0 &&
             data.completed is bool &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.priorityScore is number &&
             data.notificationEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(taskId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'description', 'importance',
                         'estimatedEffortMinutes', 'dueDate', 'completed',
                         'category', 'priorityScore', 'notificationEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'description', 'importance',
                         'estimatedEffortMinutes', 'dueDate', 'completed',
                         'category', 'priorityScore', 'notificationEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTask(incoming());

      allow update: if isSignedIn() && isValidId(taskId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTask(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'description', 'importance',
                         'estimatedEffortMinutes', 'dueDate', 'completed',
                         'category', 'priorityScore', 'notificationEnabled',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;
    }
  }
}
